# Copy this file to .env.local and fill both values in.
# .env.local is gitignored; also add these two to your host's env vars
# (Vercel: Project → Settings → Environment Variables) or RSVPs return 503.

# 1. In Telegram, message @BotFather → /newbot → follow the prompts.
#    It replies with a token that looks like 8123456789:AAH...
TELEGRAM_BOT_TOKEN=8760810116:AAGlFaL9bZOxbqhcIY65fxdrddiocknIVCU

# 2. Decide where the bot posts.
#    Just you:  message your new bot once, then open
#               https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#               and copy result[0].message.chat.id
#    A group:   create the group, add the bot as a member, send any message
#               in it, then use the same getUpdates URL. Group ids are
#               negative, e.g. -1001234567890 — keep the minus sign.
TELEGRAM_CHAT_ID=367549949
